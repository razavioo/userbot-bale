[Unit]
Description=baleobala relay proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/baleobala-run/project
ExecStart=/root/baleobala-run/project/.venv/bin/python -u -m baleobala.cli bale-proxy relay \
    --transport dc \
    --channels 8 \
    --bale-jwt-file /root/baleobala-run/.bale_jwt_a \
    --answer \
    --answer-timeout 86400 \
    --proxy-secret-file /root/baleobala-run/baleobala-vpn.psk \
    --ws-ssl-no-verify
Restart=always
RestartSec=10
StandardOutput=append:/tmp/baleobala-relay.log
StandardError=append:/tmp/baleobala-relay.log
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
