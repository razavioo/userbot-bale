<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UserbotBaleVpn" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/text_primary_on_dark</item>
        <item name="colorSecondary">@color/brand_primary_hover</item>
        <item name="colorOnSecondary">@color/brand_on_primary</item>
        <item name="colorTertiary">@color/state_warning</item>

        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark_elevated</item>
        <item name="colorSurfaceVariant">@color/surface_dark_raised</item>
        <item name="colorSurfaceContainer">@color/surface_dark_elevated</item>
        <item name="colorSurfaceContainerHigh">@color/surface_dark_raised</item>
        <item name="colorOnSurface">@color/text_primary_on_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_on_dark</item>
        <item name="colorOutline">@color/border_strong</item>
        <item name="colorOutlineVariant">@color/border_subtle</item>

        <item name="colorError">@color/state_error</item>
        <item name="colorOnError">@color/brand_on_primary</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="Theme.UserbotBaleVpn.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary_on_dark</item>
        <item name="subtitleTextColor">@color/text_secondary_on_dark</item>
        <item name="navigationIconTint">@color/text_primary_on_dark</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.Material3.TitleLarge</item>
    </style>
</resources>
