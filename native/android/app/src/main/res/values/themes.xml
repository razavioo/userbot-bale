        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/text_primary_on_dark</item>
        <item name="colorSecondary">#0F766E</item>
        <item name="colorTertiary">#F59E0B</item>

        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="colorSurface">@color/surface_dark_elevated</item>
        <item name="colorOnSurface">@color/text_primary_on_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_on_dark</item>
