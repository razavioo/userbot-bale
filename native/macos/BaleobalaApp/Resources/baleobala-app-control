#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_src=$(CDPATH= cd -- "${script_dir}/../../../../src" 2>/dev/null && pwd || true)

if [ -d "${script_dir}/baleobala" ]; then
  export PYTHONPATH="${script_dir}${PYTHONPATH:+:${PYTHONPATH}}"
elif [ -n "${repo_src}" ] && [ -d "${repo_src}/baleobala" ]; then
  export PYTHONPATH="${repo_src}${PYTHONPATH:+:${PYTHONPATH}}"
elif [ -n "${BALEOBALA_PYTHONPATH:-}" ]; then
  export PYTHONPATH="${BALEOBALA_PYTHONPATH}${PYTHONPATH:+:${PYTHONPATH}}"
fi

if [ -n "${BALEOBALA_PYTHON:-}" ]; then
  python_bin="${BALEOBALA_PYTHON}"
elif [ -x /usr/local/bin/python3 ]; then
  python_bin=/usr/local/bin/python3
elif [ -x /opt/homebrew/bin/python3 ]; then
  python_bin=/opt/homebrew/bin/python3
else
  python_bin=/usr/bin/python3
fi

exec "${python_bin}" -m baleobala.control.app_control "$@"
